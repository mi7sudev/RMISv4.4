DATABASE_URL=file:/home/z/my-project/db/custom.db

# TEMPORARILY OFF (user request): allows admin/evaluator login from any host.
# Restore to "on" before production deployment.
INTRANET_ENFORCEMENT=off

# ── Email delivery (ported from the production-verified RMISv4.1 deployment) ──
