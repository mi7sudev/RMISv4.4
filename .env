DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Two-door gate classification (spec §2.2) ────────────────────────────────
# Employee door = staff hosts + intranet source IPs; public applicant door =
# RMIS_PUBLIC_HOSTS. Host classification wins over IP (see src/lib/auth.ts).
# TEMPORARILY OFF (user request): allows admin/evaluator login from any host.
# Restore to "on" before production deployment.
INTRANET_ENFORCEMENT=off
RMIS_INTRANET_HOSTS=10.10.120.102
RMIS_PUBLIC_HOSTS=recruitment.bakalmirdc.site

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Sandbox uses Cloudflare's OFFICIAL always-pass dummy pair — valid on any
# domain (localhost, preview proxy), so the public-door flow is fully testable
# here. The REAL domain-locked pair lives in the production .env on
# 10.10.120.102 (recruitment.bakalmirdc.site will not pass locally with it).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# REAL production pair (uncomment ONLY on the production server):
# TURNSTILE_SITE_KEY=0x4AAAAAAFFxBetq_7Nsxcwa
# TURNSTILE_SECRET_KEY=0x4AAAAAAFFxBRJILQqaCPNtSb_HDAWGksk

# ── Email (mirdc_middleware gateway, port 3232) ─────────────────────────────
# Sandbox keeps "mock" so nothing is actually sent; production .env sets
# EMAIL_PROVIDER=gateway with these same gateway coordinates.
EMAIL_PROVIDER=mock
EMAIL_GATEWAY_URL=http://10.10.120.32:3232
EMAIL_GATEWAY_KEY=78e69d5bef243d02d0a4151a862c273f3897f5eb4fbce9ed8a2c2378aae94337
